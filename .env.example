# Copy this file to `.env.local` when you are ready to connect a real Supabase project.
# Until then, the app will stay in safe fallback mode and keep auth/data disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional fallback if your hosting/provider exposes the public key under a different name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Comma-separated list of admin emails that can open `/admin`.
ADMIN_EMAILS=
